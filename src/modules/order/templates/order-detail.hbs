<!DOCTYPE html>
<html>
<head>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    
    @page {
      margin: 0;
    }
    
    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      padding: 40px;
      color: #1f2937;
      line-height: 1.5;
    }
    
    .header {
      border-bottom: 2px solid #e5e7eb;
      padding-bottom: 30px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    
    .logo {
      text-align: left;
    }
    
    .company-name {
      font-size: 28px;
      font-weight: 700;
      color: #4E7772;
      letter-spacing: -0.5px;
    }
    
    .receipt-label {
      font-size: 14px;
      color: #6b7280;
      margin-top: 4px;
    }
    
    .order-meta {
      text-align: right;
    }
    
    .order-number {
      font-size: 16px;
      color: #4b5563;
      margin-bottom: 4px;
    }
    
    .info-section {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }
    
    .info-box {
      padding: 20px;
      background: #f8fafc;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
    }
    
    .info-box h3 {
      margin: 0 0 16px 0;
      color: #4E7772;
      font-size: 16px;
      font-weight: 600;
    }
    
    .info-box p {
      margin: 8px 0;
      font-size: 14px;
    }
    
    .product-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 30px 0;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
    }
    
    .product-table th {
      background: #f3f4f6;
      padding: 16px;
      text-align: left;
      font-weight: 600;
      font-size: 14px;
      color: #4b5563;
    }
    
    .product-table td {
      padding: 16px;
      border-bottom: 1px solid #e5e7eb;
      font-size: 14px;
    }
    
    .product-table tr:last-child td {
      border-bottom: none;
    }
    
    .product-image {
      width: 60px;
      height: 60px;
      border-radius: 8px;
      object-fit: cover;
      margin-right: 12px;
    }
    
    .product-cell {
      display: flex;
      align-items: center;
    }
    
    .product-name {
      font-weight: 500;
    }
    
    .product-brand {
      color: #6b7280;
      font-size: 13px;
    }
    
    .status-badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-weight: 500;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 0.5px;
    }
    
    .status-confirmed {
      background: #dcfce7;
      color: #166534;
    }
    
    .totals {
      margin-left: auto;
      width: 300px;
      background: #f8fafc;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
    }
    
    .total-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-size: 14px;
    }
    
    .grand-total {
      font-size: 18px;
      font-weight: 600;
      border-top: 2px solid #4E7772;
      margin-top: 12px;
      padding-top: 12px;
    }
    
    .footer {
      margin-top: 60px;
      text-align: center;
      color: #6b7280;
      font-size: 13px;
      border-top: 1px solid #e2e8f0;
      padding-top: 30px;
    }

    .qr-code {
      display: flex;
      justify-content: center;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo">
      <img src="https://f209kkb4-3222.asse.devtunnels.ms/brand/uploads/walkway.png" alt="Walkway" srcset="https://f209kkb4-3222.asse.devtunnels.ms/brand/uploads/walkway.png  ">
      <div class="receipt-label">Order Receipt</div>
    </div>
    <div class="order-meta">
      <div class="order-number">Receipt: {{order.receipt}}</div>
      <div>Date: {{formatDate order.order_date}}</div>
      <span class="status-badge status-{{toLowerCase order.status}}">
        {{order.status}}
      </span>
    </div>
  </div>

  <div class="info-section">
    <div class="info-box">
      <h3>Customer Information</h3>
      <p><strong>Name:</strong> {{order.address.contact_name}}</p>
      <p><strong>Phone:</strong> {{formatPhoneNumber order.address.contact_number}}</p>
    </div>

    <div class="info-box">
      <h3>Shipping Address</h3>
      <p>{{order.address.address}}</p>
      <p>{{order.address.district}}, {{order.address.city}}</p>
      <p>{{order.address.province}}, {{order.address.zipcode}}</p>
      {{#if order.address.note}}
      <p><strong>Note:</strong> {{order.address.note}}</p>
      {{/if}}
    </div>
  </div>

  <table class="product-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Brand</th>
        <th>Size</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      {{#each order.orderItems}}
      <tr>
        <td>
          <div class="product-cell">
            <div>
              <div class="product-name">{{this.productDetail.product.brand.name}} {{this.productDetail.product.name}}</div>
              <div class="product-brand">{{this.productDetail.product.brand.name}}</div>
            </div>
          </div>
        </td>
        <td>{{this.productDetail.product.brand.name}}</td>
        <td>{{this.productDetail.size}}</td>
        <td>Rp {{formatPrice this.productDetail.product.price}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="totals">
    <div class="total-row">
      <span>Subtotal:</span>
      <span>Rp {{formatSubTotal order.order_total}}</span>
    </div>
    <div class="total-row">
      <span>Shipping:</span>
      <span>Rp 10,000</span>
    </div>
    <div class="total-row grand-total">
      <span>Total:</span>
      <span>Rp {{formatPrice order.order_total}}</span>
    </div>
  </div>

  <div class="footer">
    <p>Order ID: {{order.id}}</p>
    <p>Thank you for shopping with Walkway!</p>
    <p>Questions? Contact us at support@walkway.com</p>
  </div>
</body>
</html>