<!DOCTYPE html>
<html>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        font-family: 'Poppins', sans-serif;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background-color: #f3f4f6;
        padding: 2rem;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: white;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .header {
        text-align: center;
        margin-bottom: 2rem;
      }
      .celebration-header {
        color: #4f46e5;
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }
      .win-message {
        color: #374151;
        font-size: 1.1rem;
        line-height: 1.6;
      }
      .product-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.5rem;
        margin: 1.5rem 0;
      }
      .product-title {
        color: #1f2937;
        font-weight: 500;
        margin-bottom: 1rem;
      }
      .product-detail {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
        color: #4b5563;
      }
      .product-label {
        font-weight: 500;
      }
      .timer-section {
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        padding: 1rem;
        margin: 1.5rem 0;
        color: #9a3412;
      }
      .payment-button {
        display: inline-block;
        background-color: #4f46e5;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 500;
        margin-top: 1rem;
        transition: background-color 0.2s;
      }
      .payment-button:hover {
        background-color: #4338ca;
      }
      .footer {
        text-align: center;
        color: #6b7280;
        font-size: 0.875rem;
        margin-top: 2rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <img
          src="{{walkwayLogo}}"
          alt="Celebration Icon"
          style="margin-bottom: 1rem"
        />
        <h1 class="celebration-header">🎉 Congratulations, {{name}}! 🎉</h1>
        <p class="win-message">
          Your winning bid has secured you an exceptional item!
        </p>
      </div>

      <div class="product-card">
        <h2 class="product-title">Your Winning Item</h2>
        <div class="product-detail">
          <span class="product-label">Product</span>
          <span>{{productName}}</span>
        </div>
        <div class="product-detail">
          <span class="product-label">Brand</span>
          <span>{{brandName}}</span>
        </div>
        <div class="product-detail">
          <span class="product-label">Winning Bid</span>
          <span style="color: #059669; font-weight: 600">Rp {{amount}}</span>
        </div>
      </div>

      <div class="timer-section">
        <h3 style="margin-bottom: 0.5rem; font-weight: 600">
          ⏳ Time Sensitive
        </h3>
        <p>
          Please complete your payment within the next 3 hours to secure your
          item. After this period, the winning bid will expire and the item will
          be offered to the next highest bidder.
        </p>
      </div>

      <div style="text-align: center">
        <a href="{{link}}" class="payment-button">
          Complete Payment Now
        </a>
      </div>

      <div class="footer">
        <p>Need assistance? Our support team is here to help 24/7</p>
        <p style="margin-top: 0.5rem">
          © 2024 Walkway. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
